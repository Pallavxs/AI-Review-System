NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/ai-review-system

# Frontend origin (CORS)
CLIENT_URL=http://localhost:5173

# Public URL customers open via QR / NFC (used in docs and client config)
PUBLIC_FEEDBACK_URL=http://localhost:5173

# Business branding (served to the client via /api/config)
BUSINESS_NAME=Dula mobiles
BUSINESS_LOCATION=Anuppur, Madhya Pradesh
BUSINESS_LOGO_URL=/assets/dulamobiles.jpeg

# Google review write page — every customer gets this link.
# Replace with the direct "Write a review" URL from Google Business Profile.
# Do not leave YOUR_PLACE_ID in production.
GOOGLE_REVIEW_URL=https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID

# Primary AI provider (gemini or groq)
AI_PRIMARY_PROVIDER=gemini
AI_PROVIDER_ORDER=gemini,groq

# Google Gemini (primary provider)
# Create a key in Google AI Studio; never commit the real value.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Groq fallback
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Fallback controls
AI_FALLBACK_ENABLED=true
AI_REQUEST_TIMEOUT_MS=8000
AI_MAX_ATTEMPTS_PER_PROVIDER=1
